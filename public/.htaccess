# Mosk Unlimited – Hostinger (Apache/LiteSpeed). Ersetzt _redirects + netlify.toml.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# www -> ohne www (HTTPS erzwingen: in Hostinger unter SSL einschalten)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

RewriteRule ^admin$ /admin/ [L,R=301]

# Statusdatei des Deploy-Werkzeugs (GitHub Actions) nie ausliefern
RewriteRule (^|/)\.ftp-deploy-sync-state\.json$ - [F,L]

# Vorhandene Dateien und Ordner direkt ausliefern
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fehlende Dateien mit Endung -> echtes 404 statt Startseite
RewriteRule \.[a-zA-Z0-9]+$ - [R=404,L]

# Alles andere ist eine Seite der App (/portfolio, /services/event, ...)
RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"

# Startseite immer frisch, damit neue Versionen sofort sichtbar sind
<FilesMatch "^index\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
# Dateinamen mit Hash ändern sich bei jeder neuen Version -> lange cachen
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
